{
    "name": "batteryincluded/batteryincluded-bundle",
    "type": "symfony-bundle",
    "autoload": {
        "psr-4": {
            "Batteryincluded\\BatteryincludedBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Batteryincluded\\BatteryincludedBundleTests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "teiling88",
            "email": "teiling88@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "symfony/dependency-injection": "^7.0 | ^8.0",
        "symfony/console": "^7.0 | ^8.0",
        "symfony/yaml": "^7.0 | ^8.0",
        "symfony/config": "^7.0 | ^8.0",
        "symfony/http-kernel": "^7.0 | ^8.0",
        "batteryincluded/batteryincluded-php-sdk": "dev-main",
        "ext-curl": "*",
        "symfony/routing": "^7.0 | ^8.0",
        "symfony/http-foundation": "^7.0 | ^8.0",
        "twig/twig": "^3.0",
        "symfony/service-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "symfony/stopwatch": "^7.0 | ^8.0"
    },
    "suggest": {
        "symfony/twig-bundle": "Renders the demo shop and the web profiler panel",
        "symfony/web-profiler-bundle": "Shows the BatteryIncluded api calls in the toolbar and profiler",
        "ext-intl": "Localized prices, numbers and dates in the demo shop"
    }
}
