{# templates/data_collector/template.html.twig #}
{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block menu %}
    <span class="label">
        <span class="icon">
        {{ include('@Batteryincluded/collector/icon.svg') }}
        </span>
        <strong>Batteryincluded</strong>
    </span>
{% endblock %}

{% macro render_array(array) %}
    <ul>
        {% for key, value in array %}
            <li>
                <strong>{{ key }}:</strong>
                {% if value is iterable  %}
                    {{ _self.render_array(value) }}
                {% else %}
                    {{ value }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% import _self as macros %}

{% block panel %}
    <h2>Batteryincluded</h2>
    <div class="sf-tabs">
        <div class="tab">
            <h3 class="tab-title">Requests</h3>
             <div class="tab-content">
                {{ macros.render_array(collector.requests) }}
            </div>
        </div>
    </div>
{% endblock %}

